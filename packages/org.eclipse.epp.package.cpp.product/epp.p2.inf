instructions.configure=\
  mkdir(path:${installFolder}/dropins);

properties.1.name = org.eclipse.equinox.p2.description
properties.1.value = 2026-12 Release of the Eclipse C/C++ Developers Developers package.

properties.2.name = org.eclipse.equinox.p2.provider
properties.2.value = Eclipse Packaging Project

# Specify this as a requirement with a version range rather than as <plugin id="slf4j.simple"/> in the product.
# This way we can specify a version range that allows the logger bundle to be updated without requiring the product to be updated.
requires.1.namespace = org.eclipse.equinox.p2.iu
requires.1.name = slf4j.simple
requires.1.range = [2.0.0,3.0.0)
